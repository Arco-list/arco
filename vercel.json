      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync-gsc-indexation",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-gmail",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync-growth-metrics",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-platform-prospects",
